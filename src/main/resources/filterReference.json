{
  "filters": [
    {
      "beanId": "clientCSRFTokenAsyncFilter",
      "scope": "singleton",
      "params": [
        "clientIP",
        "clientAgent",
        "clientCSRFToken"
      ]
    },
    {
      "beanId": "clientCredentialsAsyncFilter",
      "scope": "singleton",
      "params": [
        "clientUsername",
        "clientPassword"
      ],
      "output": [
        "clientCredentialsAsyncFilter.jwtToken"
      ]
    },
    {
      "beanId": "clientRateLimitAsyncFilter",
      "scope": "singleton",
      "params": [
        "clientIP",
        "clientAgent",
        "clientRateLimitTitle"
      ]
    },
    {
      "beanId": "clientWhiteListAsyncFilter",
      "scope": "singleton",
      "params": [
        "clientIP",
        "clientAgent"
      ]
    },
    {
      "beanId": "clientJWTTokenAsyncFilter",
      "scope": "singleton",
      "params": [
        "clientJWTToken"
      ]
    },
    {
      "beanId": "externalUserCSRFTokenAsyncFilter",
      "scope": "singleton",
      "params": [
        "externalUserIP",
        "externalUserAgent",
        "externalUserCSRFToken"
      ]
    },
    {
      "beanId": "externalUserCredentialsAsyncFilter",
      "scope": "singleton",
      "params": [
        "externalUserUsername",
        "externaleUserPassword"
      ],
      "output": [
        "externalUserCredentialsAsyncFilter.jwtToken"
      ]
    },
    {
      "beanId": "externalUserRateLimitAsyncFilter",
      "scope": "singleton",
      "params": [
        "externalUserIP",
        "externalUserAgent",
        "externalUserRateLimitTitle"
      ]
    },
    {
      "beanId": "externalUserJWTTokenAsyncFilter",
      "scope": "singleton",
      "params": [
        "externalUserJWTToken"
      ]
    }
  ]
}